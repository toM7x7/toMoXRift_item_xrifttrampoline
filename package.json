    "@react-three/uikit": "1.0.64",
    "@xrift/world-components": "0.60.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.183.1"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "1.4.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "5.1.4",
    "typescript": "5.9.3",
    "vite": "7.3.1"
